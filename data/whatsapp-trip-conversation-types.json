{
  "version": 1,
  "sources": ["whatsapp_messages", "chats+messages propietario=Profesional_App"],
  "table": "whatsapp_messages",
  "purpose": "Tipos de pedido y seguimiento para alimentar el chatbot de Profesional Remis. Fuentes: whatsapp_messages (remis) y chats+messages con propietario Profesional_App. El contexto se limpia solo con un viaje nuevo.",
  "message_shape": {
    "id": "uuid",
    "conversation_id": "uuid",
    "external_message_id": "string",
    "direction": "incoming|outgoing",
    "message_type": "text|audio|location|poll|image",
    "content": "string|null",
    "transcription": "string|null",
    "created_at": "timestamptz"
  },
  "session_rules": {
    "reset_context_when": ["trip_request nuevo", "schedule_trip nuevo", "new_trip=true"],
    "keep_context_when": ["status_query", "cancel_trip", "price_inquiry", "ack", "saludo", "pregunta sobre el viaje pedido"]
  },
