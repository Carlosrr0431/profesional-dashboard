# NOTA: EAS ignora este archivo. El .easignore activo está en la raíz del monorepo:
# ProfesionalApp/.easignore
# (Expo solo lee .easignore en la raíz del repositorio git.)
#
# Referencia local — rutas relativas a ProfesionalApp/:

# Otros sub-proyectos
driver-app/
profesional-dashboard/
infra/
railway-services/
builds/

# Metadatos del monorepo (no necesarios para compilar)
.github/
.cursor/
.agents/
.vscode/
*.md
skills-lock.json
test-viajes-whatsapp.txt

# Artefactos locales de passenger-app
passenger-app/node_modules/
passenger-app/.expo/
passenger-app/dist/
passenger-app/coverage/
passenger-app/.tools/

# Inspecciones EAS anidadas (copias locales del monorepo, ~3 GB)
passenger-app/.eas-inspect/
passenger-app/.eas-inspect-vcs/
passenger-app/.eas-inspect-vcs2/
**/.eas-inspect/
**/.eas-inspect-vcs/
**/.eas-inspect-vcs2/

passenger-app/android/app/build/
passenger-app/android/.gradle/
passenger-app/android/build/
passenger-app/android/app/.cxx/
passenger-app/ios/Pods/
passenger-app/ios/build/

passenger-app/*.tsbuildinfo
passenger-app/*.log
passenger-app/npm-debug.*
passenger-app/yarn-debug.*
passenger-app/yarn-error.*

passenger-app/.env
passenger-app/.env.local

**/*.zip
**/*.7z
*firebase-adminsdk*.json

# Código compartido del monorepo (imports ../../../shared)
!shared/
!shared/**

# Firebase Android
!passenger-app/google-services.json
!passenger-app/android/app/google-services.json
