{
  "name": "passenger-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/start-expo.js",
    "start:clean": "node scripts/start-expo.js --clear",
    "qr": "node scripts/print-qr.js",
    "android": "expo run:android",
    "rebuild:android": "expo prebuild --clean --platform android && expo run:android",
    "ios": "expo run:ios",
    "build:android:dev": "eas build --profile development --platform android",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:sim": "eas build --profile development-simulator --platform ios",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:ios:preview": "eas build --profile preview --platform ios",
    "assets": "node scripts/convert-assets.js",
    "web": "node -e \"console.error('passenger-app solo soporta Android/iOS. Web deshabilitado.'); process.exit(1);\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.0",
    "@maplibre/maplibre-react-native": "^11.3.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/messaging": "^24.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@supabase/supabase-js": "^2.49.0",
    "babel-preset-expo": "~54.0.10",
    "date-fns": "^4.1.0",
    "expo": "~54.0.0",
    "expo-build-properties": "^56.0.19",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
