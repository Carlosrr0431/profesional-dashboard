# EAS solo lee .easignore en la raíz del repositorio git (ProfesionalApp/).
# Copia de .gitignore + exclusiones extra para builds de passenger-app.

# Dependencies
node_modules/
**/node_modules/

# Expo / React Native
.expo/
dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Secrets / credentials
**/firebase-adminsdk*.json
**/google-services.json
!passenger-app/google-services.json
!passenger-app/android/app/google-services.json
profesionaapp-firebase-adminsdk*.json

.env.local
.env.*.local
**/.env
!**/.env.example

# Build outputs
**/android/app/build/
**/android/.gradle/
**/android/build/
**/android/app/.cxx/
**/ios/Pods/
**/ios/build/
coverage/

# OSM data
infra/geospatial/data/
*.osm.pbf
*.osrm*

# IDE / tools
.tools/
*.code-workspace
.DS_Store
Thumbs.db

.cursor/
.agents/
.github/

# Railway service repos
railway-services/profesional-osrm/
railway-services/profesional-nominatim/

# --- Exclusiones monorepo (solo subir passenger-app + shared) ---
driver-app/
profesional-dashboard/
infra/
railway-services/
builds/
scripts/

# Inspecciones EAS locales (~3 GB de copias anidadas)
passenger-app/.eas-inspect/
passenger-app/.eas-inspect-vcs/
passenger-app/.eas-inspect-vcs2/
**/.eas-inspect/
**/.eas-inspect-vcs/
**/.eas-inspect-vcs2/

# Docs raíz
*.md
skills-lock.json
test-viajes-whatsapp.txt

**/*.zip
**/*.7z

# Código compartido necesario para Metro
!shared/
!shared/**
